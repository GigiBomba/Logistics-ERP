# ── Database ────────────────────────────────────────────────────────────
OPERION_DB_ENGINE=postgresql
OPERION_POSTGRES_DSN=postgresql://operion:${OPERION_DB_PASSWORD:-changeme}@postgres:5432/operion
OPERION_DB_PASSWORD=your-secure-db-password

# ── Redis ───────────────────────────────────────────────────────────────
OPERION_REDIS_PASSWORD=your-redis-password

# ── Security (generate with: openssl rand -hex 32) ──────────────────────
OPERION_JWT_SECRET_KEY=your-jwt-secret-key-64-chars-minimum
OPERION_API_KEY=your-global-api-key
OPERION_ENCRYPTION_KEY=your-encryption-key

# ── CORS ────────────────────────────────────────────────────────────────
OPERION_CORS_ORIGINS=https://app.operionerp.xyz,https://api.operionerp.xyz

# ── Rate Limiting ────────────────────────────────────────────────────────
OPERION_RATE_LIMIT=100

# ── Environment ──────────────────────────────────────────────────────────
OPERION_ENVIRONMENT=production

# ── PgAdmin (management profile) ────────────────────────────────────────
PGADMIN_EMAIL=admin@operionerp.xyz
PGADMIN_PASSWORD=your-pgadmin-password
