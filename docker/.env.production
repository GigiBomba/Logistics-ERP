# ── Operion ERP Production Environment ──────────────────────────────
# Copy this file to your production secrets manager (Docker secrets,
# Vault, or env injection). NEVER commit real secrets to git.
#
# Generate keys with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Mode ───────────────────────────────────────────────────────────
OPERION_ENV=production

# ── Database ────────────────────────────────────────────────────────
OPERION_DB_ENGINE=postgresql
OPERION_POSTGRES_DSN=postgresql://user:password@db:5432/operion
# Or use SQLite with a persistent path:
# OPERION_DB_PATH=/data/cashflow.db

# ── Redis ───────────────────────────────────────────────────────────
OPERION_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
OPERION_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ─────────────────────────────────────────────────────────────
OPERION_JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
OPERION_JWT_ALGORITHM=HS256
OPERION_ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── API Key (transport-layer auth) ─────────────────────────────────
OPERION_API_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32

# ── Admin gateway ──────────────────────────────────────────────────
OPERION_ADMIN_EMAIL=admin@yourcompany.com
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(12)).decode())"
OPERION_ADMIN_PASSWORD_HASH=

# ── CORS (comma-separated origins allowed) ──────────────────────────
OPERION_CORS_ORIGINS=https://operionerp.xyz,https://app.operionerp.xyz,https://api.operionerp.xyz

# ── Audit / Logging ────────────────────────────────────────────────
OPERION_AUDIT_LOG_DIR=/var/log/operion/audit
OPERION_LOGS_DIR=/var/log/operion

# ── External APIs ──────────────────────────────────────────────────
OPERION_GRAPHHOPPER_URL=https://maps.operionerp.xyz
# OPERION_CURRENCY_API=https://open.er-api.com/v6/latest/EUR

# ── SMTP ────────────────────────────────────────────────────────────
# OPERION_SMTP_SERVER=smtp.yourprovider.com
# OPERION_SMTP_PORT=587
# OPERION_SMTP_USER=your-smtp-user
# OPERION_SMTP_PASSWORD=your-smtp-password
# OPERION_SMTP_FROM=noreply@operionerp.xyz

# ── Celery worker restricted user ──────────────────────────────────
# Create a restricted PostgreSQL user for Celery workers
# (see docker/init-db.sh and database/migrations/002_create_celery_user.sql)
OPERION_CELERY_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ── Rate Limiting ──────────────────────────────────────────────────
OPERION_RATE_LIMIT=100

# ── R2 / S3 Backup Storage ────────────────────────────────────────
# Enable after creating an R2 bucket via the Cloudflare dashboard:
#   aws s3 mb s3://operion-backups --endpoint-url https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
