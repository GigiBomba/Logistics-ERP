# Operion ERP Environment Configuration
# ⚠ Never commit this file. Copy to .env for local development.

# ── Database ────────────────────────────────────────────────────────────
# Engine: "sqlite" (default) or "postgresql"
OPERION_DB_ENGINE=sqlite

# SQLite: path to the database file (default: data/cashflow.db)
OPERION_DB_PATH=data/cashflow.db

# PostgreSQL: full DSN (used when OPERION_DB_ENGINE=postgresql)
# OPERION_POSTGRES_DSN=postgresql://user:pass@localhost:5432/operion

# Connection pool tuning (PostgreSQL only)
# OPERION_DB_POOL_MIN=2
# OPERION_DB_POOL_MAX=20

# Redis
OPERION_REDIS_URL=redis://localhost:6379/0
OPERION_REDIS_CACHE_TTL=3600

# Celery
OPERION_CELERY_BROKER=redis://localhost:6379/1
OPERION_CELERY_RESULT=redis://localhost:6379/2

# API Server
OPERION_API_HOST=127.0.0.1
OPERION_API_PORT=8000
OPERION_API_WORKERS=4

# Desktop Client
OPERION_API_BASE_URL=http://127.0.0.1:8000

# Production environment ("development" | "production")
# When set to "production", /docs and /redoc are disabled.
OPERION_ENV=development

# CORS allowed origins (comma-separated)
# OPERION_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security — generate a key with: openssl rand -hex 32
# REQUIRED in production: JWT signing secret
OPERION_JWT_SECRET_KEY=
# REQUIRED in production: transport-layer API key
OPERION_API_KEY=
# REQUIRED in production: field-level encryption key
OPERION_ENCRYPTION_KEY=
OPERION_ACCESS_TOKEN_EXPIRE_MINUTES=15
OPERION_BCRYPT_ROUNDS=12

# Admin gateway (set OPERION_ADMIN_EMAIL + hashed password)
# Generate hash with: python scripts/hash_admin_password.py
# OPERION_ADMIN_EMAIL=admin@example.com
# OPERION_ADMIN_PASSWORD_HASH=$2b$12$...

# Logging
OPERION_LOGS_DIR=data/logs

# Reports
OPERION_REPORTS_DIR=data/reports

# ── operion-ops support-service proxy ─────────────────────────────
# REQUIRED in production: generate with: openssl rand -hex 32
OPERION_SUPPORT_INTERNAL_AUTH=
# Dev-only default; point to your deployed support service in production.
# OPERION_SUPPORT_SERVICE_URL=http://host.docker.internal:8100

# ── AI provider API keys (env-first; prefs.json is only a fallback) ─
# Never commit real values here.
OPERION_GEMINI_API_KEY=
OPERION_QWEN_API_KEY=
# Google AI Studio — SDK-native env var (used by GoogleProvider when
# OPERION_GEMINI_API_KEY is unset)
GOOGLE_API_KEY=
