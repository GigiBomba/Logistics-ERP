# Operion ERP — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Paths ────────────────────────────────────────────────────────
# OPERION_DB_PATH=data/cashflow.db
# OPERION_LOGS_DIR=logs
# OPERION_REPORTS_DIR=reports

# ── API Endpoints ─────────────────────────────────────────────────
# OPERION_GRAPHHOPPER_URL=http://localhost:8989
# OPERION_NOMINATIM_URL=https://nominatim.openstreetmap.org
# OPERION_CURRENCY_API=https://open.er-api.com/v6/latest/EUR
# OPERION_CURRENCY_API_FALLBACK=https://api.frankfurter.dev/latest?from=EUR

# ── Fleet Tracking APIs ───────────────────────────────────────────
# OPERION_WIALON_HOST=https://hst-api.wialon.com
# OPERION_WIALON_TOKEN=your-wialon-token
# OPERION_FROTCOM_USERNAME=your-username
# OPERION_FROTCOM_PASSWORD=your-password
# OPERION_NAVIXY_API_KEY=your-api-key
# OPERION_NAVIXY_HOST=https://api.eu.navixy.com/v2

# ── SMTP (Email Reports / Invoices) ───────────────────────────────
# OPERION_SMTP_SERVER=smtp.gmail.com
# OPERION_SMTP_PORT=587
# OPERION_SMTP_USER=your-email@gmail.com
# OPERION_SMTP_PASSWORD=your-app-password

# ── Feature Flags ─────────────────────────────────────────────────
# OPERION_ENABLE_FLEET_TRACKING=false
# OPERION_ENABLE_AI=false

# ── Cost Defaults ─────────────────────────────────────────────────
# OPERION_DEFAULT_DRIVER_SALARY=100.0
# OPERION_DEFAULT_TOLL_RATE=0.22
# OPERION_EXTRA_COST_PER_KM=0.03
# OPERION_EXTRA_COST_PER_DAY=12.0
