{
  "name": "operion-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "tsc -b && npx tsx scripts/generate-sitemap.ts && npx tsx scripts/generate-og-images.ts && vike build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "i18n:audit": "npx tsx scripts/i18n-audit.ts",
    "audit:hardcoded": "npx tsx scripts/hardcoded-strings-audit.ts",
    "stress": "k6 run stress/k6-login.js && k6 run stress/k6-dashboard-load.js && k6 run stress/k6-notification-polling.js && k6 run stress/k6-spike-test.js && k6 run stress/k6-static-pages.js && k6 run stress/k6-sustained-browsing.js && k6 run stress/k6-api-endpoints.js",
    "stress:login": "k6 run stress/k6-login.js",
    "stress:dashboard": "k6 run stress/k6-dashboard-load.js",
    "stress:notifications": "k6 run stress/k6-notification-polling.js",
    "stress:spike": "k6 run stress/k6-spike-test.js",
    "stress:static": "k6 run stress/k6-static-pages.js",
    "stress:sustained": "k6 run stress/k6-sustained-browsing.js",
    "stress:endpoints": "k6 run stress/k6-api-endpoints.js",
    "stress:watch": "set K6_WEB_DASHBOARD=true&& k6 run stress/k6-login.js",
    "test:coverage": "vitest run --coverage",
    "test:manifest": "npx tsx scripts/verify-ui-test-manifest.ts",
    "test:visual": "npx playwright test e2e/visual-regression.spec.ts",
    "test:mutation": "npx stryker run src/__tests__/mutation/stryker.conf.json",
    "test:mutation:record": "npm run test:mutation && npx tsx scripts/record-mutation-score.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@marsidev/react-turnstile": "^1.5.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.81.0",
    "react-router": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vike": "^0.4.260",
    "vike-react": "^0.6.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
