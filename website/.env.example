# ═══════════════════════════════════════════════════════════════════════
# Operion Website — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# VITE_API_URL defaults to https://api.operionerp.xyz (production).
# Do NOT set it to localhost — the backend is NOT served from a
# dev-server URL. The backend API always runs at api.operionerp.xyz.
#
# VITE_JWT_SECRET must match the backend's OPERION_JWT_SECRET_KEY
# so the frontend can verify JWT signatures.  The default fallback
# ("change-me-to-a-random-secret-key") will NOT match the production
# backend.  Set it here or leave unset to rely on the fallback (dev only).
#
# ── Ports ──
# Frontend (Vite dev):  npm run dev  → http://localhost:5173
# Frontend (serve.js):  node serve.js → http://localhost:8080
# Backend API:           always at https://api.operionerp.xyz
#
# ── Required ──
# VITE_API_URL=https://api.operionerp.xyz
# VITE_JWT_SECRET=your-production-secret-here

# ── Analytics ──
VITE_GA_MEASUREMENT_ID=

# ── Bot Protection (Cloudflare Turnstile) ──
VITE_TURNSTILE_SITE_KEY=

# ── Feature Flags ──
VITE_ENABLE_ANALYTICS=false

# ── Stripe ──
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Maintenance Mode ──
# Set to "true" to show the maintenance page for all public (non-dashboard) routes.
# Dashboard and auth pages remain accessible so administrators can manage the site.
# VITE_MAINTENANCE_MODE=false

# ── Blog API (build time) ──
# Used by scripts/generate-sitemap.ts and scripts/generate-og-images.ts to fetch
# real blog slugs from https://api.operionerp.xyz/api/v1/blog/posts at build time.
# The API requires a bearer token; when unset, the scripts gracefully fall back
# to the static route list / seed slugs.
# BLOG_API_TOKEN=
