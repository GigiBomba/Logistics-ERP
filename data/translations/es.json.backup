  "features": {
    "page_title": "Features - Operion ERP",
    "page_header": "Powerful Features for Modern Logistics",
    "page_header_desc": "Everything you need to run your fleet efficiently, from route planning to analytics.",
    "category_route_planning": "Route Planning & Optimization",
    "route_planning_title": "Intelligent Route Planning",
    "route_planning_desc": "Advanced algorithms optimize for time, distance, fuel, and toll costs across Europe.",
    "multi_stop_title": "Multi-Stop Optimization",
    "multi_stop_desc": "Plan complex multi-stop routes with up to 50 waypoints and automated sequencing.",
    "traffic_title": "Real-Time Traffic Integration",
    "traffic_desc": "Routes adjust dynamically based on live traffic conditions and road closures.",
    "category_fleet": "Fleet Management",
    "gps_tracking_title": "Real-Time GPS Tracking",
    "gps_tracking_desc": "Monitor every vehicle's location, speed, and status on an interactive map.",
    "maintenance_title": "Vehicle Maintenance Tracking",
    "maintenance_desc": "Schedule and track maintenance with automated alerts for inspections, insurance, and services.",
    "geofencing_title": "Geofencing & Alerts",
    "geofencing_desc": "Set geographic boundaries and receive instant notifications when vehicles enter or leave zones.",
    "category_dispatch": "Dispatch & Operations",
    "auto_assign_title": "Automated Job Assignment",
    "auto_assign_desc": "Match jobs to the best available drivers and trucks based on location, skills, and compliance.",
    "pod_title": "Digital Proof of Delivery",
    "pod_desc": "Capture signatures, photos, and timestamps at delivery for complete proof of delivery.",
    "status_updates_title": "Real-Time Status Updates",
    "status_updates_desc": "Track every job from assignment to completion with live status updates.",
    "category_documents": "Document Management",
    "ocr_ai_title": "AI-Powered OCR",
    "ocr_ai_desc": "Scan and digitize invoices, CMRs, receipts, and contracts with AI-powered OCR.",
    "digital_archive_title": "Digital Archive",
    "digital_archive_desc": "Store and search all documents with version history, tags, and full-text search.",
    "auto_invoicing_title": "Automated Invoicing",
    "auto_invoicing_desc": "Generate invoices from delivery data automatically and email them to clients.",
    "category_analytics": "Analytics & Reporting",
    "dashboards_title": "Custom Dashboards",
    "dashboards_desc": "Build personalized views with KPIs, charts, and real-time data.",
    "kpi_title": "KPI Tracking",
    "kpi_desc": "Monitor key performance indicators including profit per mile, fuel efficiency, and driver performance.",
    "export_title": "Export & Integration",
    "export_desc": "Export reports in multiple formats and integrate with your existing ERP and accounting software.",
    "category_drivers": "Driver Management",
    "driver_profiles_title": "Driver Profiles",
    "driver_profiles_desc": "Complete driver database with licenses, medical certificates, contracts, and documents.",
